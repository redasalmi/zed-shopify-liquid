{
  "name": "zed-shopify-liquid-tests",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:repository": "node scripts/check-repository-contracts.cjs",
    "test": "npm run check:repository && npm run test:snippets && npm run test:lsp && npm run test:queries",
    "test:snippets": "node --test tests/snippets.test.cjs",
    "test:lsp": "node --test --test-concurrency=1 tests/language-server/*.test.cjs",
    "test:queries": "node --test tests/queries/*.test.cjs",
    "test:stress": "node --test tests/language-server/embedded-stress.test.cjs"
  },
  "devDependencies": {
    "@shopify/theme-language-server-node": "2.22.1",
    "tree-sitter-cli": "0.22.6",
    "tree-sitter-liquid": "https://github.com/redasalmi/tree-sitter-liquid/archive/0e228e6d080f1fc7b0e6a661479004c16c8d2514.tar.gz",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "tree-sitter-cli@0.22.6": true,
    "https://github.com/redasalmi/tree-sitter-liquid/archive/0e228e6d080f1fc7b0e6a661479004c16c8d2514.tar.gz": false,
    "tree-sitter": false
  }
}
